@model IEnumerable<PPMS.Models.Staff>
@{ ViewData["Title"] = "Staff Management"; }
<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h2><i class="fas fa-users-cog me-2" style="color:#16a34a;"></i>Staff Management</h2>
        <p class="text-muted mb-0" style="font-size:0.8rem;">Manage prison staff and personnel across all facilities</p>
    </div>
    <a href="/Staff/Create" class="btn btn-primary"><i class="fas fa-plus me-2"></i>Add Staff</a>
</div>
<div class="card mb-4"><div class="card-body py-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-4"><div class="input-group input-group-sm"><span class="input-group-text"><i class="fas fa-search"></i></span><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by name, staff ID or email..." /></div></div>
        <div class="col-md-3">@Html.DropDownList("prisonId", ViewBag.Prisons as Microsoft.AspNetCore.Mvc.Rendering.SelectList, "All Prisons", new{@class="form-select form-select-sm"})</div>
        <div class="col-md-3">
            <select name="role" class="form-select form-select-sm">
                <option value="">All Roles</option>
                @foreach(var r in new[]{"Warden","Guard","Medical Officer","Administrator","Counselor","Security Officer"})
                { <option value="@r" selected="@(ViewBag.Role as string == r ? "selected" : null)">@r</option> }
            </select>
        </div>
        <div class="col-md-2"><button type="submit" class="btn btn-primary btn-sm w-100"><i class="fas fa-filter me-1"></i>Filter</button></div>
    </form>
</div></div>
@if (!Model.Any())
{
    <div class="card"><div class="card-body text-center py-5"><i class="fas fa-users-cog fa-3x mb-3 text-muted opacity-50"></i><h5 class="text-muted">No staff found</h5><a href="/Staff/Create" class="btn btn-primary mt-2"><i class="fas fa-plus me-1"></i>Add Staff Member</a></div></div>
}
else
{
    <div class="card"><div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead><tr><th>Staff ID</th><th>Full Name</th><th>Role</th><th class="d-none d-lg-table-cell">Prison</th><th class="d-none d-md-table-cell">Phone</th><th class="d-none d-xl-table-cell">Shift</th><th>Status</th><th>Actions</th></tr></thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td><code style="font-size:0.8rem;">@s.StaffIdNumber</code></td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div style="width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,#16a34a,#22c55e);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:0.85rem;flex-shrink:0;">@(s.FullName.Length > 0 ? s.FullName[0].ToString().ToUpper() : "?")</div>
                                    <div>
                                        <a href="/Staff/Details/@s.Id" class="text-decoration-none fw-semibold" style="font-size:0.88rem;">@s.FullName</a>
                                        <div class="text-muted" style="font-size:0.72rem;">@s.Gender</div>
                                    </div>
                                </div>
                            </td>
                            <td><span class="badge bg-info text-dark" style="font-size:0.72rem;">@s.Role</span></td>
                            <td class="d-none d-lg-table-cell" style="font-size:0.85rem;">@s.Prison?.PrisonName</td>
                            <td class="d-none d-md-table-cell" style="font-size:0.85rem;">@s.PhoneNumber</td>
                            <td class="d-none d-xl-table-cell" style="font-size:0.82rem;color:var(--bs-secondary-color);">@s.ShiftSchedule</td>
                            <td><span class="badge @(s.IsActive?"bg-success":"bg-secondary")">@(s.IsActive?"Active":"Inactive")</span></td>
                            <td><div class="d-flex gap-1">
                                <a href="/Staff/Details/@s.Id" class="btn btn-outline-info" style="padding:3px 7px;font-size:0.72rem;"><i class="fas fa-eye"></i></a>
                                <a href="/Staff/Edit/@s.Id" class="btn btn-outline-primary" style="padding:3px 7px;font-size:0.72rem;"><i class="fas fa-edit"></i></a>
                                <a href="/Staff/Delete/@s.Id" class="btn btn-outline-danger" style="padding:3px 7px;font-size:0.72rem;"><i class="fas fa-trash"></i></a>
                            </div></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div></div>
    @await Html.PartialAsync("_Pagination")
}
