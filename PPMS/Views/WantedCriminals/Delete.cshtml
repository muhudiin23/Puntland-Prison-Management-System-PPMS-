@model PPMS.Models.WantedCriminal
@{ ViewData["Title"] = "Remove Wanted Criminal"; }
<div class="page-header"><h2><i class="fas fa-trash me-2 text-danger"></i>Remove Wanted Criminal</h2></div>
<div class="card" style="max-width:500px;margin:0 auto;">
    <div class="card-body text-center py-5">
        <i class="fas fa-exclamation-triangle fa-3x text-danger mb-3"></i>
        <h5>Remove "@Model.CriminalName" from wanted list?</h5>
        <p class="text-muted">Risk Level: @Model.RiskLevel</p>
        <form asp-action="Delete" method="post" class="d-inline me-2">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-danger">Yes, Remove</button>
        </form>
        <a href="/WantedCriminals" class="btn btn-outline-secondary">Cancel</a>
    </div>
</div>
