@model PPMS.Models.Staff
@{ ViewData["Title"] = "Edit Staff"; }
<div class="page-header"><h2><i class="fas fa-user-edit me-2" style="color:#16a34a;"></i>Edit Staff Member</h2></div>
<div class="card" style="max-width:800px;">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <div class="row g-3">
                <div class="col-md-6"><label class="form-label fw-semibold">Full Name *</label><input asp-for="FullName" class="form-control" /></div>
                <div class="col-md-3"><label class="form-label fw-semibold">Staff ID</label><input asp-for="StaffIdNumber" class="form-control" /></div>
                <div class="col-md-3"><label class="form-label fw-semibold">Gender</label><select asp-for="Gender" class="form-select"><option>Male</option><option>Female</option></select></div>
                <div class="col-md-4"><label class="form-label fw-semibold">Phone</label><input asp-for="PhoneNumber" class="form-control" /></div>
                <div class="col-md-4"><label class="form-label fw-semibold">Email</label><input asp-for="Email" type="email" class="form-control" /></div>
                <div class="col-md-4"><label class="form-label fw-semibold">Role</label><select asp-for="Role" class="form-select"><option>Warden</option><option>Guard</option><option>Medical Officer</option><option>Administrator</option><option>Counselor</option><option>Security Officer</option></select></div>
                <div class="col-md-4"><label class="form-label fw-semibold">Prison</label>@Html.DropDownList("PrisonId", ViewBag.Prisons as SelectList, "-- Select --", new{@class="form-select"})</div>
                <div class="col-md-4"><label class="form-label fw-semibold">Shift</label><select asp-for="ShiftSchedule" class="form-select"><option>Morning (06:00-14:00)</option><option>Afternoon (14:00-22:00)</option><option>Night (22:00-06:00)</option><option>Full Day</option></select></div>
                <div class="col-md-4"><label class="form-label fw-semibold">Username</label><input asp-for="Username" class="form-control" /></div>
                <div class="col-12">
                    <div class="form-check"><input asp-for="IsActive" class="form-check-input" type="checkbox" /><label class="form-check-label">Active</label></div>
                </div>
                <div class="col-12 d-flex gap-2">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>Save Changes</button>
                    <a href="/Staff" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </div>
        </form>
    </div>
</div>
