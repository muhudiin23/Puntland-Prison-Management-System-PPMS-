@model PPMS.Models.Staff
@{ ViewData["Title"] = "Staff Details"; }
<div class="page-header d-flex justify-content-between align-items-center">
    <h2><i class="fas fa-id-badge me-2"></i>Staff Profile</h2>
    <div>
        <a href="/Staff/Edit/@Model.Id" class="btn btn-primary btn-sm"><i class="fas fa-edit me-1"></i>Edit</a>
        <a href="/Staff" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>Back</a>
    </div>
</div>

@if (TempData["Success"] != null) {
    <div class="alert alert-success alert-dismissible fade show"><i class="fas fa-check-circle me-2"></i>@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="card" style="max-width:750px;">
    <div class="card-body">
        <div class="d-flex align-items-center gap-4 mb-4">
            @if (!string.IsNullOrEmpty(Model.PhotoPath)) {
                <img src="@Model.PhotoPath" style="width:90px;height:100px;object-fit:cover;border-radius:8px;border:3px solid #e2e8f0;" />
            } else {
                <div style="width:90px;height:100px;border-radius:8px;background:#1565c0;display:flex;align-items:center;justify-content:center;color:#fff;font-size:2.5rem;font-weight:700;flex-shrink:0;">@(Model.FullName.Length > 0 ? Model.FullName[0].ToString().ToUpper() : "?")</div>
            }
            <div>
                <h4 class="mb-1">@Model.FullName</h4>
                <span class="badge bg-info text-dark">@Model.Role</span>
                <span class="badge @(Model.IsActive?"bg-success":"bg-secondary") ms-1">@(Model.IsActive?"Active":"Inactive")</span>
            </div>
        </div>
        <div class="row g-3">
            <div class="col-md-4"><small class="text-muted d-block">Staff ID</small><strong>@Model.StaffIdNumber</strong></div>
            <div class="col-md-4"><small class="text-muted d-block">Gender</small><strong>@Model.Gender</strong></div>
            <div class="col-md-4"><small class="text-muted d-block">Phone</small><strong>@Model.PhoneNumber</strong></div>
            <div class="col-md-4"><small class="text-muted d-block">Email</small><strong>@Model.Email</strong></div>
            <div class="col-md-4"><small class="text-muted d-block">Prison</small><strong>@Model.Prison?.PrisonName</strong></div>
            <div class="col-md-4"><small class="text-muted d-block">Shift</small><strong>@Model.ShiftSchedule</strong></div>
            <div class="col-md-4"><small class="text-muted d-block">Username</small><strong>@Model.Username</strong></div>
            <div class="col-md-4"><small class="text-muted d-block">Joined</small><strong>@Model.CreatedAt.ToString("MMM dd, yyyy")</strong></div>
        </div>
    </div>
</div>

{{!-- Education Certificates Section --}}
<div class="card mt-3" style="max-width:750px;">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fas fa-graduation-cap me-2 text-success"></i>Education Certificates</span>
        <span class="badge bg-secondary">@Model.Certificates.Count file(s)</span>
    </div>
    <div class="card-body">
        @if (Model.Certificates.Any()) {
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-3">
                    <thead class="table-light">
                        <tr>
                            <th>File Name</th>
                            <th>Type</th>
                            <th>Size</th>
                            <th>Uploaded</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cert in Model.Certificates.OrderByDescending(c => c.UploadedAt)) {
                            <tr>
                                <td><i class="fas @(cert.FileType=="pdf"?"fa-file-pdf text-danger":cert.FileType=="docx"?"fa-file-word text-primary":"fa-file-image text-info") me-1"></i>@cert.OriginalName</td>
                                <td><span class="badge bg-light text-dark">@cert.FileType.ToUpper()</span></td>
                                <td>@((cert.FileSize / 1024.0).ToString("F1")) KB</td>
                                <td>@cert.UploadedAt.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <a href="/Staff/DownloadCertificate/@cert.Id" class="btn btn-outline-primary btn-sm" title="Download"><i class="fas fa-download"></i></a>
                                    <form asp-action="DeleteCertificate" asp-controller="Staff" method="post" class="d-inline" onsubmit="return confirm('Delete this certificate?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@cert.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete"><i class="fas fa-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        } else {
            <p class="text-muted mb-3"><i class="fas fa-info-circle me-1"></i>No certificates uploaded yet.</p>
        }

        <form asp-action="UploadCertificate" asp-controller="Staff" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" name="staffId" value="@Model.Id" />
            <div class="d-flex gap-2 align-items-end flex-wrap">
                <div style="flex:1;min-width:200px;">
                    <label class="form-label small fw-semibold mb-1">Upload Certificate(s)</label>
                    <input type="file" name="certificates" class="form-control form-control-sm" accept=".pdf,.docx,.jpg,.jpeg,.png" multiple required />
                    <small class="text-muted">PDF, DOCX, JPG, PNG — max 10MB each</small>
                </div>
                <button type="submit" class="btn btn-success btn-sm"><i class="fas fa-upload me-1"></i>Upload</button>
            </div>
        </form>
    </div>
</div>
