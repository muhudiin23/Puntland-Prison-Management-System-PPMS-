@model IEnumerable<PPMS.Models.WantedCriminal>
@{ ViewData["Title"] = "Wanted Criminals"; }
<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h2><i class="fas fa-exclamation-triangle me-2 text-danger"></i>Wanted Criminals</h2>
        <p class="text-muted mb-0" style="font-size:0.8rem;">Track and manage all wanted criminals across Puntland</p>
    </div>
    <a href="/WantedCriminals/Create" class="btn btn-danger"><i class="fas fa-plus me-2"></i>Add Wanted Criminal</a>
</div>
<div class="card mb-4"><div class="card-body py-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-5"><div class="input-group input-group-sm"><span class="input-group-text"><i class="fas fa-search"></i></span><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by name, national ID or crime..." /></div></div>
        <div class="col-md-3">
            <select name="riskLevel" class="form-select form-select-sm">
                <option value="">All Risk Levels</option>
                @foreach(var r in new[]{"Low","Medium","High","Critical"})
                { <option value="@r" selected="@(ViewBag.RiskLevel as string == r ? "selected" : null)">⚠️ @r</option> }
            </select>
        </div>
        <div class="col-md-2"><button type="submit" class="btn btn-danger btn-sm w-100"><i class="fas fa-search me-1"></i>Search</button></div>
        @if (!string.IsNullOrEmpty(ViewBag.Search as string) || !string.IsNullOrEmpty(ViewBag.RiskLevel as string))
        { <div class="col-md-2"><a href="/WantedCriminals" class="btn btn-outline-secondary btn-sm w-100">Clear</a></div> }
    </form>
</div></div>

@if (!Model.Any())
{
    <div class="card"><div class="card-body text-center py-5"><i class="fas fa-check-circle fa-3x mb-3 text-success"></i><h5>No wanted criminals found</h5><p class="text-muted">@(ViewBag.Search != null ? "Try adjusting your search." : "No wanted criminals in the system.")</p></div></div>
}
else
{
    <div class="row g-3">
        @foreach (var w in Model)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card h-100 @(w.RiskLevel=="Critical"?"border border-danger border-2":"")">
                    @if (w.RiskLevel == "Critical")
                    {
                        <div style="background:#dc2626;color:#fff;padding:4px 12px;font-size:0.68rem;font-weight:800;text-transform:uppercase;letter-spacing:1px;">⚠ CRITICAL RISK — DANGEROUS</div>
                    }
                    <div class="card-body">
                        <div class="d-flex gap-3">
                            @if (!string.IsNullOrEmpty(w.PhotoPath))
                            {
                                <img src="@w.PhotoPath" style="width:72px;height:85px;object-fit:cover;border-radius:8px;flex-shrink:0;border:2px solid #fca5a5;" />
                            }
                            else
                            {
                                <div style="width:72px;height:85px;border-radius:8px;background:#fef2f2;display:flex;align-items:center;justify-content:center;flex-shrink:0;border:2px dashed #fca5a5;font-size:2rem;color:#fca5a5;">?</div>
                            }
                            <div class="flex-grow-1 min-w-0">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <h6 class="mb-0 fw-bold text-truncate" style="max-width:150px;">@w.CriminalName</h6>
                                    <span class="badge ms-1 flex-shrink-0" style="font-size:0.65rem;background:@(w.RiskLevel=="Critical"?"#dc2626":w.RiskLevel=="High"?"#ea580c":w.RiskLevel=="Medium"?"#d97706":"#16a34a");">@w.RiskLevel</span>
                                </div>
                                @if (!string.IsNullOrEmpty(w.NationalId)) { <p class="text-muted mb-1" style="font-size:0.75rem;">ID: @w.NationalId</p> }
                                <p class="mb-1" style="font-size:0.8rem;line-height:1.3;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">@w.CrimeDescription</p>
                                @if (!string.IsNullOrEmpty(w.LastKnownLocation))
                                { <p class="text-muted mb-0" style="font-size:0.75rem;"><i class="fas fa-map-marker-alt me-1 text-danger"></i>@w.LastKnownLocation</p> }
                                <p class="text-muted mb-0 mt-1" style="font-size:0.7rem;"><i class="fas fa-calendar me-1"></i>@w.DateAdded.ToString("MMM dd, yyyy")</p>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer d-flex gap-1 py-2">
                        <a href="/WantedCriminals/Details/@w.Id" class="btn btn-sm btn-outline-info flex-fill" style="font-size:0.78rem;"><i class="fas fa-eye me-1"></i>View</a>
                        <a href="/WantedCriminals/Edit/@w.Id" class="btn btn-sm btn-outline-primary flex-fill" style="font-size:0.78rem;"><i class="fas fa-edit me-1"></i>Edit</a>
                        <a href="/WantedCriminals/Delete/@w.Id" class="btn btn-sm btn-outline-danger" style="font-size:0.78rem;padding:4px 10px;"><i class="fas fa-trash"></i></a>
                    </div>
                </div>
            </div>
        }
    </div>
    @await Html.PartialAsync("_Pagination")
}
