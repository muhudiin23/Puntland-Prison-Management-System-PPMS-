@model IEnumerable<PPMS.Models.ApplicationUser>
@{ ViewData["Title"] = "User Management"; }
<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h2><i class="fas fa-user-shield me-2" style="color:#7c3aed;"></i>User Management</h2>
        <p class="text-muted mb-0" style="font-size:0.8rem;">Manage system accounts, roles and access control</p>
    </div>
    <a href="/Users/Create" class="btn btn-primary"><i class="fas fa-plus me-2"></i>Add User</a>
</div>
<div class="card mb-4"><div class="card-body py-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-4"><div class="input-group input-group-sm"><span class="input-group-text"><i class="fas fa-search"></i></span><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by name, username or email..." /></div></div>
        <div class="col-md-3"><select name="role" class="form-select form-select-sm"><option value="">All Roles</option><option value="SuperAdmin" selected="@(ViewBag.Role as string == "SuperAdmin" ? "selected" : null)">Super Admin</option><option value="PrisonAdministrator" selected="@(ViewBag.Role as string == "PrisonAdministrator" ? "selected" : null)">Prison Administrator</option><option value="StaffUser" selected="@(ViewBag.Role as string == "StaffUser" ? "selected" : null)">Staff User</option></select></div>
        <div class="col-md-2"><button type="submit" class="btn btn-primary btn-sm w-100"><i class="fas fa-filter me-1"></i>Filter</button></div>
    </form>
</div></div>
<div class="card"><div class="card-body p-0">
    <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>User</th>
                <th class="d-none d-md-table-cell">Email</th>
                <th>Role</th>
                <th class="d-none d-lg-table-cell">Assigned Prison</th>
                <th class="d-none d-xl-table-cell">Last Login</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model)
            {
                var prisonName = u.AssignedPrison?.PrisonName;
                <tr>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            @if (!string.IsNullOrEmpty(u.ProfilePhotoPath))
                            { <img src="@u.ProfilePhotoPath" style="width:36px;height:36px;border-radius:50%;object-fit:cover;" /> }
                            else
                            { <div style="width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,#7c3aed,#a855f7);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:0.85rem;">@(u.FullName.Length > 0 ? u.FullName[0].ToString().ToUpper() : "?")</div> }
                            <div>
                                <div class="fw-semibold" style="font-size:0.875rem;">@u.FullName</div>
                                <div class="text-muted" style="font-size:0.72rem;">@@@u.UserName</div>
                            </div>
                        </div>
                    </td>
                    <td class="d-none d-md-table-cell text-muted" style="font-size:0.84rem;">@u.Email</td>
                    <td>
                        <span class="badge" style="font-size:0.7rem;background:@(u.Role=="SuperAdmin"?"#dc2626":u.Role=="PrisonAdministrator"?"#d97706":"#0891b2");">
                            @(u.Role == "PrisonAdministrator" ? "Prison Admin" : u.Role == "SuperAdmin" ? "Super Admin" : "Staff User")
                        </span>
                    </td>
                    <td class="d-none d-lg-table-cell" style="font-size:0.84rem;">
                        @if (!string.IsNullOrEmpty(prisonName))
                        {
                            <span style="display:inline-flex;align-items:center;gap:5px;">
                                <i class="fas fa-building text-muted" style="font-size:0.7rem;"></i>
                                @prisonName
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td class="d-none d-xl-table-cell text-muted" style="font-size:0.78rem;">
                        @if (u.LastLoginAt.HasValue)
                        {
                            <span title="@u.LastLoginAt.Value.ToString("yyyy-MM-dd HH:mm:ss")">
                                @u.LastLoginAt.Value.ToString("MMM dd, HH:mm")
                            </span>
                        }
                        else { <span>Never</span> }
                    </td>
                    <td><span class="badge @(u.IsActive?"bg-success":"bg-secondary")">@(u.IsActive?"Active":"Disabled")</span></td>
                    <td>
                        <div class="d-flex gap-1">
                            <a href="/Users/Edit/@u.Id" class="btn btn-outline-primary" style="padding:3px 7px;font-size:0.72rem;"><i class="fas fa-edit"></i></a>
                            <form asp-action="Disable" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@u.Id" />
                                <button type="submit" class="btn @(u.IsActive?"btn-outline-warning":"btn-outline-success")" style="padding:3px 7px;font-size:0.72rem;" title="@(u.IsActive?"Disable":"Enable")">
                                    <i class="fas @(u.IsActive?"fa-ban":"fa-check")"></i>
                                </button>
                            </form>
                            <button class="btn btn-outline-secondary" style="padding:3px 7px;font-size:0.72rem;" title="Reset Password" data-bs-toggle="modal" data-bs-target="#resetModal" data-uid="@u.Id" data-name="@u.FullName"><i class="fas fa-key"></i></button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div></div>
@await Html.PartialAsync("_Pagination")

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="modal fade" id="resetModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title"><i class="fas fa-key me-2"></i>Reset Password</h6>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="ResetPassword" method="post" id="resetModalForm" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" name="fromIndex" value="true" />
                <div class="modal-body">
                    <p class="text-muted small mb-3" id="resetUserName"></p>
                    <input type="hidden" name="id" id="resetUserId" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold">New Password *</label>
                        <div class="input-group">
                            <input type="password" name="newPassword" id="modalNewPwd"
                                   class="form-control" placeholder="Min 8 characters, must include a digit" autocomplete="new-password" />
                            <button type="button" class="btn btn-outline-secondary" onclick="toggleModalVis('modalNewPwd','modalEyeNew')" tabindex="-1">
                                <i class="fas fa-eye" id="modalEyeNew"></i>
                            </button>
                        </div>
                        <div class="invalid-feedback" id="modalNewPwdErr" style="display:none;"></div>
                    </div>
                    <div class="mb-1">
                        <label class="form-label fw-semibold">Confirm Password *</label>
                        <div class="input-group">
                            <input type="password" name="confirmPassword" id="modalConfirmPwd"
                                   class="form-control" placeholder="Repeat new password" autocomplete="new-password" />
                            <button type="button" class="btn btn-outline-secondary" onclick="toggleModalVis('modalConfirmPwd','modalEyeConfirm')" tabindex="-1">
                                <i class="fas fa-eye" id="modalEyeConfirm"></i>
                            </button>
                        </div>
                        <div class="invalid-feedback" id="modalConfirmPwdErr" style="display:none;"></div>
                    </div>
                    <div class="form-text mt-2"><i class="fas fa-info-circle me-1"></i>At least 8 characters, must include at least one digit.</div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger btn-sm"><i class="fas fa-key me-1"></i>Reset Password</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.getElementById('resetModal').addEventListener('show.bs.modal', function(e) {
    var btn = e.relatedTarget;
    document.getElementById('resetUserId').value = btn.dataset.uid;
    document.getElementById('resetUserName').textContent = 'Resetting password for: ' + btn.dataset.name;
    // Clear fields and errors each time modal opens
    document.getElementById('modalNewPwd').value = '';
    document.getElementById('modalConfirmPwd').value = '';
    document.getElementById('modalNewPwd').classList.remove('is-invalid');
    document.getElementById('modalConfirmPwd').classList.remove('is-invalid');
    document.getElementById('modalNewPwdErr').style.display = 'none';
    document.getElementById('modalConfirmPwdErr').style.display = 'none';
});

document.getElementById('resetModalForm').addEventListener('submit', function(e) {
    var np = document.getElementById('modalNewPwd').value;
    var cp = document.getElementById('modalConfirmPwd').value;
    var newErr = document.getElementById('modalNewPwdErr');
    var conErr = document.getElementById('modalConfirmPwdErr');
    var ok = true;

    document.getElementById('modalNewPwd').classList.remove('is-invalid');
    document.getElementById('modalConfirmPwd').classList.remove('is-invalid');
    newErr.style.display = 'none';
    conErr.style.display = 'none';

    if (np.length < 8) {
        newErr.textContent = 'Password must be at least 8 characters.';
        newErr.style.display = 'block';
        document.getElementById('modalNewPwd').classList.add('is-invalid');
        ok = false;
    } else if (!/\d/.test(np)) {
        newErr.textContent = 'Password must contain at least one digit.';
        newErr.style.display = 'block';
        document.getElementById('modalNewPwd').classList.add('is-invalid');
        ok = false;
    }
    if (np !== cp) {
        conErr.textContent = 'Passwords do not match.';
        conErr.style.display = 'block';
        document.getElementById('modalConfirmPwd').classList.add('is-invalid');
        ok = false;
    }
    if (!ok) e.preventDefault();
});

function toggleModalVis(inputId, iconId) {
    var inp = document.getElementById(inputId);
    var ico = document.getElementById(iconId);
    inp.type = inp.type === 'text' ? 'password' : 'text';
    ico.className = inp.type === 'text' ? 'fas fa-eye-slash' : 'fas fa-eye';
}
</script>
}
