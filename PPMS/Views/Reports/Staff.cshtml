@model IEnumerable<PPMS.Models.Staff>
@{ ViewData["Title"] = "Staff Report"; }
<div class="page-header d-flex justify-content-between align-items-center no-print">
    <h2><i class="fas fa-users-cog me-2"></i>Staff Report</h2>
    <div class="d-flex gap-2">
        <a href="/Reports/ExportStaffExcel" class="btn btn-success btn-sm"><i class="fas fa-file-excel me-1"></i>Export Excel</a>
        <button onclick="window.print()" class="btn btn-outline-secondary btn-sm"><i class="fas fa-print me-1"></i>Print</button>
        <a href="/Reports" class="btn btn-outline-secondary btn-sm">Back</a>
    </div>
</div>
<div class="card mb-3 no-print"><div class="card-body py-2">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-3"><select name="prisonId" class="form-select form-select-sm"><option value="">All Prisons</option>@foreach(var p in ViewBag.Prisons as List<PPMS.Models.Prison>??new()){<option value="@p.Id">@p.PrisonName</option>}</select></div>
        <div class="col-md-3"><input name="role" class="form-control form-control-sm" placeholder="Filter by role..." /></div>
        <div class="col-auto"><button type="submit" class="btn btn-primary btn-sm">Filter</button></div>
    </form>
</div></div>
<div class="card">
    <div class="card-header d-flex justify-content-between"><span>Staff Report &mdash; @DateTime.Now.ToString("MMMM dd, yyyy")</span><span>Total: @Model.Count()</span></div>
    <div class="card-body p-0">
        <table class="table table-sm mb-0">
            <thead><tr><th>#</th><th>Staff ID</th><th>Name</th><th>Role</th><th>Prison</th><th>Phone</th><th>Email</th><th>Shift</th><th>Status</th></tr></thead>
            <tbody>
                @{ int i=1; }
                @foreach (var s in Model) {
                    <tr><td>@i++</td><td><code>@s.StaffIdNumber</code></td><td>@s.FullName</td><td>@s.Role</td><td>@s.Prison?.PrisonName</td><td>@s.PhoneNumber</td><td>@s.Email</td><td>@s.ShiftSchedule</td><td><span class="badge @(s.IsActive?"bg-success":"bg-secondary")">@(s.IsActive?"Active":"Inactive")</span></td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
<style>@@media print { .no-print { display:none!important; } #sidebar, #topbar { display:none!important; } #main-content { margin-left:0!important; } }</style>
