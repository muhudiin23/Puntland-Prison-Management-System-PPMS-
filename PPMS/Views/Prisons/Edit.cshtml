@model PPMS.Models.Prison
@{ ViewData["Title"] = "Edit Prison"; }
<div class="page-header"><h2><i class="fas fa-edit me-2" style="color:#d97706;"></i>Edit Prison</h2></div>
<div class="card" style="max-width:700px;">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <div class="row g-3">
                <div class="col-md-8"><label class="form-label fw-semibold">Prison Name *</label><input asp-for="PrisonName" class="form-control" /><span asp-validation-for="PrisonName" class="text-danger small"></span></div>
                <div class="col-md-4"><label class="form-label fw-semibold">City *</label><input asp-for="City" class="form-control" /></div>
                <div class="col-md-4"><label class="form-label fw-semibold">Capacity *</label><input asp-for="Capacity" type="number" class="form-control" /></div>
                <div class="col-md-4"><label class="form-label fw-semibold">Current Population</label><input asp-for="CurrentPopulation" type="number" class="form-control" /></div>
                <div class="col-md-4"><label class="form-label fw-semibold">Security Level</label><select asp-for="SecurityLevel" class="form-select"><option>Minimum</option><option>Medium</option><option>Maximum</option></select></div>
                <div class="col-12"><label class="form-label fw-semibold">Address</label><input asp-for="Address" class="form-control" /></div>
                <div class="col-md-6"><label class="form-label fw-semibold">Contact Number</label><input asp-for="ContactNumber" class="form-control" /></div>
                <div class="col-12 d-flex gap-2 mt-2">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>Save Changes</button>
                    <a href="/Prisons" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </div>
        </form>
    </div>
</div>
