@model IEnumerable<PPMS.Models.FormerPrisoner>
@{ ViewData["Title"] = "Former Prisoners Archive"; }

<style>
.arc-card { border-radius:18px; padding:18px 20px; position:relative; overflow:hidden; transition:transform .2s ease, box-shadow .25s ease; border:none; cursor:default; }
.arc-card:hover { transform:translateY(-3px); }
.arc-card .arc-num { font-size:2.2rem; font-weight:900; color:#fff; line-height:1; }
.arc-card .arc-lbl { font-size:0.68rem; font-weight:800; color:rgba(255,255,255,0.75); text-transform:uppercase; letter-spacing:1.5px; margin-top:3px; }
.arc-card .arc-ico { position:absolute; right:14px; bottom:14px; font-size:2.4rem; opacity:0.18; color:#fff; }
.status-released    { background:linear-gradient(135deg,#166534,#16a34a); box-shadow:0 6px 18px rgba(22,101,52,0.35); }
.status-transferred { background:linear-gradient(135deg,#1e3a8a,#2563eb); box-shadow:0 6px 18px rgba(37,99,235,0.35); }
.status-deceased    { background:linear-gradient(135deg,#1f2937,#374151); box-shadow:0 6px 18px rgba(31,41,55,0.4); }
.status-admin       { background:linear-gradient(135deg,#78350f,#d97706); box-shadow:0 6px 18px rgba(120,53,15,0.35); }
.status-total       { background:linear-gradient(135deg,#0d1b2a,#1b3a6b); box-shadow:0 6px 18px rgba(13,27,42,0.45); }
.archive-row td { font-size:0.85rem; vertical-align:middle; }
.reason-badge { font-size:0.7rem; padding:3px 10px; border-radius:20px; font-weight:700; }
.reason-Released    { background:#dcfce7; color:#166534; }
.reason-Transferred { background:#dbeafe; color:#1e40af; }
.reason-Deceased    { background:#f3f4f6; color:#374151; }
.reason-Administrative { background:#fef3c7; color:#92400e; }
</style>

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h2><i class="fas fa-archive me-2" style="color:#d97706;"></i>Former Prisoners Archive</h2>
        <p class="text-muted mb-0" style="font-size:0.8rem;">
            Permanent, immutable historical record of all former prisoners — records are never permanently deleted
        </p>
    </div>
    <div class="d-flex gap-2">
        <a href="/FormerPrisoners/ExportExcel?search=@ViewBag.Search&status=@ViewBag.Status&prisonId=@ViewBag.PrisonId&from=@ViewBag.From&to=@ViewBag.To"
           class="btn btn-success btn-sm"><i class="fas fa-file-excel me-1"></i>Export Excel</a>
        <a href="/Prisoners" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>Active Records</a>
    </div>
</div>

<!-- Summary stat cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-4 col-xl-2dot4">
        <div class="arc-card status-total">
            <div class="arc-num">@ViewBag.TotalArchived</div>
            <div class="arc-lbl">Total Archived</div>
            <i class="fas fa-archive arc-ico"></i>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2dot4">
        <div class="arc-card status-released">
            <div class="arc-num">@ViewBag.ReleasedCount</div>
            <div class="arc-lbl">Released</div>
            <i class="fas fa-door-open arc-ico"></i>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2dot4">
        <div class="arc-card status-transferred">
            <div class="arc-num">@ViewBag.TransferredCount</div>
            <div class="arc-lbl">Transferred</div>
            <i class="fas fa-exchange-alt arc-ico"></i>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2dot4">
        <div class="arc-card status-deceased">
            <div class="arc-num">@ViewBag.DeceasedCount</div>
            <div class="arc-lbl">Deceased</div>
            <i class="fas fa-cross arc-ico"></i>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2dot4">
        <div class="arc-card status-admin">
            <div class="arc-num">@ViewBag.AdminCount</div>
            <div class="arc-lbl">Administrative</div>
            <i class="fas fa-user-shield arc-ico"></i>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="card mb-4">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="fas fa-search"></i></span>
                    <input name="search" value="@ViewBag.Search" class="form-control"
                           placeholder="Name, Prisoner ID, National ID, Crime..." />
                </div>
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    @foreach (var s in new[]{"Released","Transferred","Deceased","Administrative"})
                    { <option value="@s" selected="@(ViewBag.Status as string == s ? "selected" : null)">@s</option> }
                </select>
            </div>
            <div class="col-md-2">
                @Html.DropDownList("prisonId", ViewBag.Prisons as Microsoft.AspNetCore.Mvc.Rendering.SelectList,
                    "All Prisons", new { @class = "form-select form-select-sm" })
            </div>
            <div class="col-md-2">
                <input type="date" name="from" value="@ViewBag.From" class="form-control form-control-sm" title="Archived from" />
            </div>
            <div class="col-md-2">
                <input type="date" name="to" value="@ViewBag.To" class="form-control form-control-sm" title="Archived to" />
            </div>
            <div class="col-md-1 d-flex gap-1">
                <button type="submit" class="btn btn-primary btn-sm flex-fill"><i class="fas fa-filter"></i></button>
                @if (!string.IsNullOrEmpty(ViewBag.Search as string) || !string.IsNullOrEmpty(ViewBag.Status as string)
                  || !string.IsNullOrEmpty(ViewBag.From as string) || !string.IsNullOrEmpty(ViewBag.To as string))
                {
                    <a href="/FormerPrisoners" class="btn btn-outline-secondary btn-sm"><i class="fas fa-times"></i></a>
                }
            </div>
            <div class="col-md-2">
                <select name="sort" class="form-select form-select-sm">
                    <option value="">Latest Archived</option>
                    <option value="name"      selected="@(ViewBag.Sort as string == "name"      ? "selected" : null)">Name A-Z</option>
                    <option value="name_desc" selected="@(ViewBag.Sort as string == "name_desc" ? "selected" : null)">Name Z-A</option>
                    <option value="entry"     selected="@(ViewBag.Sort as string == "entry"     ? "selected" : null)">Entry Date</option>
                    <option value="release"   selected="@(ViewBag.Sort as string == "release"   ? "selected" : null)">Release Date</option>
                    <option value="archived"  selected="@(ViewBag.Sort as string == "archived"  ? "selected" : null)">Oldest Archived</option>
                </select>
            </div>
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="fas fa-archive fa-3x mb-3 text-muted opacity-50"></i>
            <h5 class="text-muted">No archived records found</h5>
            <p class="text-muted mb-0">
                @if (!string.IsNullOrEmpty(ViewBag.Search as string) || !string.IsNullOrEmpty(ViewBag.Status as string))
                { <span>No archived prisoners match your search criteria.</span> }
                else
                { <span>The archive is currently empty. Records appear here when prisoners are archived from active records.</span> }
            </p>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="fas fa-database me-2"></i>Archived Records — @ViewBag.TotalCount total</span>
            <span class="badge bg-warning text-dark" style="font-size:0.72rem;">
                <i class="fas fa-lock me-1"></i>Permanent Record — Read-Only Archive
            </span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th style="width:48px;">Photo</th>
                            <th>Prisoner ID</th>
                            <th>Full Name</th>
                            <th class="d-none d-md-table-cell">National ID</th>
                            <th class="d-none d-lg-table-cell">Crime Type</th>
                            <th class="d-none d-xl-table-cell">Prison</th>
                            <th class="d-none d-lg-table-cell">Entry</th>
                            <th class="d-none d-md-table-cell">Archived</th>
                            <th>Status</th>
                            <th style="width:110px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            <tr class="archive-row">
                                <td>
                                    @if (!string.IsNullOrEmpty(p.PhotoPath))
                                    {
                                        <img src="@p.PhotoPath" style="width:36px;height:36px;border-radius:50%;object-fit:cover;border:2px solid #e2e8f0;opacity:0.9;" />
                                    }
                                    else
                                    {
                                        <div style="width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,#94a3b8,#64748b);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:0.85rem;">
                                            @(p.FullName.Length > 0 ? p.FullName[0].ToString().ToUpper() : "?")
                                        </div>
                                    }
                                </td>
                                <td><code style="font-size:0.78rem;">@p.PrisonerId</code></td>
                                <td>
                                    <a href="/FormerPrisoners/Details/@p.Id" class="text-decoration-none fw-semibold">@p.FullName</a>
                                    <div class="text-muted d-md-none" style="font-size:0.7rem;">@p.NationalId</div>
                                </td>
                                <td class="d-none d-md-table-cell text-muted">@p.NationalId</td>
                                <td class="d-none d-lg-table-cell">
                                    <span class="badge bg-secondary" style="font-size:0.7rem;">@p.CrimeType</span>
                                </td>
                                <td class="d-none d-xl-table-cell text-muted" style="font-size:0.82rem;">@p.PrisonName</td>
                                <td class="d-none d-lg-table-cell text-muted" style="font-size:0.8rem;">@p.EntryDate.ToString("MMM dd, yyyy")</td>
                                <td class="d-none d-md-table-cell" style="font-size:0.8rem;">
                                    @if (p.ArchivedAt.HasValue)
                                    {
                                        <span>@p.ArchivedAt.Value.ToString("MMM dd, yyyy")</span>
                                        <div class="text-muted" style="font-size:0.68rem;">@p.ArchivedBy</div>
                                    }
                                </td>
                                <td>
                                    @{
                                        var reason = p.ArchiveReason ?? "Administrative";
                                    }
                                    <span class="reason-badge reason-@reason">@reason</span>
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a href="/FormerPrisoners/Details/@p.Id"
                                           class="btn btn-xs btn-outline-info" style="padding:3px 7px;font-size:0.72rem;" title="View Record">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a href="/FormerPrisoners/PrintRecord/@p.Id"
                                           class="btn btn-xs btn-outline-secondary" style="padding:3px 7px;font-size:0.72rem;" title="Print / PDF" target="_blank">
                                            <i class="fas fa-print"></i>
                                        </a>
                                        @if (User.IsInRole("SuperAdmin") || User.IsInRole("PrisonAdministrator"))
                                        {
                                            <form asp-controller="FormerPrisoners" asp-action="Restore" method="post" class="d-inline"
                                                  onsubmit="return confirm('Restore @Html.Raw(p.FullName.Replace("'", "\\'")) to active prisoner records?')">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@p.Id" />
                                                <button type="submit" class="btn btn-xs btn-outline-success"
                                                        style="padding:3px 7px;font-size:0.72rem;" title="Restore to Active">
                                                    <i class="fas fa-undo"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    @await Html.PartialAsync("_Pagination")
}

<style>
/* 5-column layout for the stat cards */
@@media (min-width:1200px) {
    .col-xl-2dot4 { flex:0 0 auto; width:20%; }
}
</style>
