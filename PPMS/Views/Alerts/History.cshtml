@model IEnumerable<PPMS.Models.Alert>
@{ ViewData["Title"] = "Alert History"; }
<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h2><i class="fas fa-history me-2 text-secondary"></i>Alert History</h2>
        <p class="text-muted mb-0" style="font-size:0.8rem;">All dismissed alerts — @ViewBag.TotalCount total</p>
    </div>
    <a href="/Alerts" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>Back to Alerts</a>
</div>
@if (!Model.Any())
{
    <div class="card"><div class="card-body text-center py-5">
        <i class="fas fa-history fa-3x mb-3 text-muted opacity-50"></i>
        <h5 class="text-muted">No alert history</h5>
        <p class="text-muted mb-0">Dismissed alerts will appear here.</p>
    </div></div>
}
else
{
    <div class="d-flex flex-column gap-2">
        @foreach (var a in Model)
        {
            var borderColor = a.AlertType.Contains("Escape") ? "#dc2626" : a.AlertType.Contains("Wanted") ? "#7c3aed" : a.AlertType.Contains("Security") ? "#d97706" : "#0891b2";
            var iconClass  = a.AlertType.Contains("Escape") ? "fa-running" : a.AlertType.Contains("Wanted") ? "fa-exclamation-triangle" : a.AlertType.Contains("Security") ? "fa-shield-alt" : "fa-tachometer-alt";
            <div class="card opacity-75">
                <div class="card-body d-flex align-items-start gap-3 py-3" style="border-left:4px solid @borderColor;border-radius:0 14px 14px 0;">
                    <div style="width:38px;height:38px;border-radius:10px;background:rgba(0,0,0,0.05);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                        <i class="fas @iconClass" style="color:@borderColor;"></i>
                    </div>
                    <div class="flex-grow-1">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <span class="badge" style="background:@borderColor;font-size:0.68rem;">@a.AlertType</span>
                                <span class="badge @(a.Severity=="Critical"?"bg-danger":a.Severity=="High"?"bg-warning text-dark":a.Severity=="Low"?"bg-success":"bg-secondary")" style="font-size:0.65rem;">@a.Severity</span>
                                <span class="badge bg-secondary" style="font-size:0.65rem;"><i class="fas fa-check me-1"></i>Dismissed</span>
                            </div>
                            <span class="text-muted" style="font-size:0.72rem;white-space:nowrap;">@a.CreatedAt.ToString("MMM dd, yyyy HH:mm")</span>
                        </div>
                        <p class="mb-0 mt-1" style="font-size:0.875rem;">@a.Message</p>
                        <div class="text-muted mt-1" style="font-size:0.72rem;">
                            @if (!string.IsNullOrEmpty(a.CreatedBy)) { <span><i class="fas fa-user me-1"></i>Created by @a.CreatedBy</span> }
                            @if (a.DismissedAt.HasValue) { <span class="ms-2"><i class="fas fa-check me-1"></i>Dismissed @a.DismissedAt.Value.ToString("MMM dd, yyyy HH:mm")</span> }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
    @await Html.PartialAsync("_Pagination")
}
