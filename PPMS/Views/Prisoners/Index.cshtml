@model IEnumerable<PPMS.Models.Prisoner>
@{ ViewData["Title"] = "Prisoner Records"; }

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h2><i class="fas fa-user-lock me-2" style="color:#1565c0;"></i>Prisoner Records</h2>
        <p class="text-muted mb-0" style="font-size:0.8rem;">Manage and track all incarcerated individuals across Puntland</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/FormerPrisoners" class="btn btn-outline-warning btn-sm"><i class="fas fa-archive me-1"></i>Former Prisoners Archive</a>
        <a href="/Prisoners/Create" class="btn btn-primary"><i class="fas fa-plus me-2"></i>Register Prisoner</a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="fas fa-search"></i></span>
                    <input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by name, prisoner ID, national ID, crime..." />
                </div>
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select form-select-sm">
                    <option value="">All Status</option>
                    @foreach (var s in new[]{"Active","Released","Transferred","Escaped"})
                    { <option value="@s" selected="@(ViewBag.Status as string == s ? "selected" : null)">@s</option> }
                </select>
            </div>
            <div class="col-md-3">
                @Html.DropDownList("prisonId", ViewBag.Prisons as Microsoft.AspNetCore.Mvc.Rendering.SelectList, "All Prisons", new { @class="form-select form-select-sm" })
            </div>
            <div class="col-md-2">
                <select name="sort" class="form-select form-select-sm">
                    <option value="">Latest First</option>
                    <option value="name" selected="@(ViewBag.Sort as string == "name" ? "selected" : null)">Name A-Z</option>
                    <option value="release" selected="@(ViewBag.Sort as string == "release" ? "selected" : null)">Release Date</option>
                    <option value="crime" selected="@(ViewBag.Sort as string == "crime" ? "selected" : null)">Crime Type</option>
                </select>
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-primary btn-sm w-100"><i class="fas fa-filter"></i></button>
            </div>
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="fas fa-user-lock fa-3x mb-3 text-muted opacity-50"></i>
            <h5 class="text-muted">No prisoners found</h5>
            <p class="text-muted">@(ViewBag.Search != null ? "Try adjusting your search criteria." : "Register your first prisoner to get started.")</p>
            <a href="/Prisoners/Create" class="btn btn-primary mt-2"><i class="fas fa-plus me-1"></i>Register Prisoner</a>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th style="width:50px;">Photo</th>
                            <th>Prisoner ID</th>
                            <th>Full Name</th>
                            <th class="d-none d-md-table-cell">National ID</th>
                            <th class="d-none d-lg-table-cell">Crime</th>
                            <th class="d-none d-xl-table-cell">Prison</th>
                            <th class="d-none d-md-table-cell">Release Date</th>
                            <th>Status</th>
                            <th style="width:120px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(p.PhotoPath))
                                    {
                                        <img src="@p.PhotoPath" style="width:38px;height:38px;border-radius:50%;object-fit:cover;border:2px solid #e2e8f0;" />
                                    }
                                    else
                                    {
                                        <div style="width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,#e2e8f0,#cbd5e1);display:flex;align-items:center;justify-content:center;color:#64748b;font-weight:700;font-size:0.9rem;">
                                            @(p.FullName.Length > 0 ? p.FullName[0].ToString().ToUpper() : "?")
                                        </div>
                                    }
                                </td>
                                <td><code style="font-size:0.8rem;">@p.PrisonerId</code></td>
                                <td>
                                    <a href="/Prisoners/Details/@p.Id" class="text-decoration-none fw-semibold">@p.FullName</a>
                                    <div class="text-muted d-md-none" style="font-size:0.72rem;">@p.NationalId</div>
                                </td>
                                <td class="d-none d-md-table-cell text-muted" style="font-size:0.85rem;">@p.NationalId</td>
                                <td class="d-none d-lg-table-cell"><span class="badge bg-secondary" style="font-size:0.72rem;">@p.CrimeType</span></td>
                                <td class="d-none d-xl-table-cell" style="font-size:0.85rem;">@p.Prison?.PrisonName</td>
                                <td class="d-none d-md-table-cell">
                                    <span style="font-size:0.82rem;@(p.ReleaseDate < DateTime.Now ? "color:#dc2626;font-weight:600;" : "")">
                                        @p.ReleaseDate.ToString("MMM dd, yyyy")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(p.CriminalStatus=="Active"?"bg-danger":p.CriminalStatus=="Released"?"bg-success":p.CriminalStatus=="Escaped"?"bg-warning text-dark":"bg-secondary")">
                                        @p.CriminalStatus
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a href="/Prisoners/Details/@p.Id" class="btn btn-xs btn-outline-info" style="padding:3px 7px;font-size:0.72rem;" title="View"><i class="fas fa-eye"></i></a>
                                        <a href="/Prisoners/Edit/@p.Id" class="btn btn-xs btn-outline-primary" style="padding:3px 7px;font-size:0.72rem;" title="Edit"><i class="fas fa-edit"></i></a>
                                        <a href="/Prisoners/Delete/@p.Id" class="btn btn-xs btn-outline-warning" style="padding:3px 7px;font-size:0.72rem;" title="Archive to Former Prisoners"><i class="fas fa-archive"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    @await Html.PartialAsync("_Pagination")
}
