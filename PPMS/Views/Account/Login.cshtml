@model PPMS.Models.ViewModels.LoginViewModel
@{ ViewData["Title"] = "Login"; Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PPMS - Secure Login</title>
    <link rel="icon" href="/images/spf-logo.png" type="image/png" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body { background: linear-gradient(135deg, #0d1b2a 0%, #1b2e44 50%, #0d1b2a 100%); min-height: 100vh; display: flex; align-items: center; justify-content: center; font-family: 'Segoe UI', sans-serif; }
        .login-card { background: #fff; border-radius: 16px; box-shadow: 0 20px 60px rgba(0,0,0,0.4); width: 100%; max-width: 420px; overflow: hidden; }
        .login-header { background: linear-gradient(160deg, #0d1b2a 0%, #1b3a6b 60%, #1565c0 100%); padding: 36px 30px 28px; text-align: center; color: #fff; }
        .login-header h1 { font-size: 1.8rem; font-weight: 800; margin: 14px 0 4px; letter-spacing: 2px; }
        .login-header p { color: #8eafd4; font-size: 0.82rem; margin: 0; }
        .logo-wrap { width: 120px; height: 120px; border-radius: 50%; background: #ffffff; border: 4px solid rgba(255,255,255,0.4); display: flex; align-items: center; justify-content: center; margin: 0 auto; box-shadow: 0 4px 20px rgba(0,0,0,0.3); padding: 8px; }
        .logo-wrap img { width: 100%; height: 100%; object-fit: contain; }
        .logo-fallback { font-size: 3.5rem; line-height: 1; }
        .login-body { padding: 32px 30px; }
        .form-label { font-weight: 600; color: #374151; font-size: 0.85rem; }
        .form-control { border: 2px solid #e5e7eb; border-radius: 8px; padding: 10px 14px; transition: border-color 0.2s; }
        .form-control:focus { border-color: #1565c0; box-shadow: 0 0 0 3px rgba(21,101,192,0.15); }
        .input-group-text { background: #f8fafc; border: 2px solid #e5e7eb; border-right: none; border-radius: 8px 0 0 8px; color: #6b7280; }
        .input-group .form-control { border-left: none; border-radius: 0 8px 8px 0; }
        .btn-login { background: linear-gradient(135deg, #1565c0, #1976d2); border: none; padding: 12px; font-weight: 700; border-radius: 8px; font-size: 1rem; letter-spacing: 0.5px; }
        .btn-login:hover { background: linear-gradient(135deg, #0d47a1, #1565c0); }
        .security-notice { background: #f0f9ff; border: 1px solid #bae6fd; border-radius: 8px; padding: 10px 14px; font-size: 0.78rem; color: #0369a1; margin-top: 16px; }
        .login-footer { background: #f8fafc; padding: 14px; text-align: center; border-top: 1px solid #e5e7eb; font-size: 0.75rem; color: #9ca3af; }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="login-header">
            <div class="logo-wrap">
                <img src="/images/spf-logo.png" alt="PPMS Logo"
                     onerror="this.parentElement.innerHTML='<span class=\'logo-fallback\'>🏛️</span>'" />
            </div>
            <h1>PPMS</h1>
            <p>Puntland Prison Management System</p>
            <small style="color:#64a0d4;letter-spacing:1.5px;">SECURE GOVERNMENT PORTAL</small>
        </div>
        <div class="login-body">
            <h5 class="mb-4 text-center" style="color:#0d1b2a;font-weight:700;">Sign In to Your Account</h5>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger py-2 px-3" style="font-size:0.85rem;">
                    <i class="fas fa-exclamation-circle me-1"></i>
                    @Html.ValidationSummary(false, "", new { @class = "mb-0" })
                </div>
            }

            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                <div class="mb-3">
                    <label class="form-label">Username</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-user"></i></span>
                        <input asp-for="Username" class="form-control" placeholder="Enter your username" autocomplete="username" />
                    </div>
                    <span asp-validation-for="Username" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-lock"></i></span>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Enter your password" autocomplete="current-password" id="pwd" />
                        <button type="button" class="btn btn-outline-secondary border" onclick="var p=document.getElementById('pwd');p.type=p.type=='password'?'text':'password'"><i class="fas fa-eye"></i></button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-3 d-flex align-items-center justify-content-between">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" type="checkbox" />
                        <label class="form-check-label" style="font-size:0.85rem;">Remember me</label>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary btn-login w-100 text-white">
                    <i class="fas fa-sign-in-alt me-2"></i>SIGN IN SECURELY
                </button>

                <div class="security-notice mt-3">
                    <i class="fas fa-shield-alt me-1"></i>
                    This system is restricted to authorized personnel only. Unauthorized access is prohibited and subject to criminal prosecution.
                </div>
            </form>
        </div>
        <div class="login-footer">
            &copy; @DateTime.Now.Year Puntland Prison Management System &mdash; Government of Puntland
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
