@model PPMS.Models.FormerPrisoner
@{ ViewData["Title"] = $"Archive Record — {Model.FullName}"; }

@{
    var reason      = Model.ArchiveReason ?? "Administrative";
    var reasonColor = reason switch {
        "Released"      => "#166534",
        "Transferred"   => "#1e40af",
        "Deceased"      => "#374151",
        _               => "#92400e"
    };
    var reasonBg = reason switch {
        "Released"      => "#dcfce7",
        "Transferred"   => "#dbeafe",
        "Deceased"      => "#f3f4f6",
        _               => "#fef3c7"
    };
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h2><i class="fas fa-archive me-2" style="color:#d97706;"></i>Archive Record — @Model.FullName</h2>
        <p class="text-muted mb-0" style="font-size:0.8rem;">
            Permanent historical record &mdash; Prisoner ID: <code>@Model.PrisonerId</code>
        </p>
    </div>
    <div class="d-flex gap-2">
        <a href="/FormerPrisoners/PrintRecord/@Model.Id" target="_blank"
           class="btn btn-outline-secondary btn-sm"><i class="fas fa-print me-1"></i>Print / PDF</a>
        @if (User.IsInRole("SuperAdmin") || User.IsInRole("PrisonAdministrator"))
        {
            <form asp-controller="FormerPrisoners" asp-action="Restore" method="post" class="d-inline"
                  onsubmit="return confirm('Restore this prisoner to active records?')">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-success btn-sm">
                    <i class="fas fa-undo me-1"></i>Restore to Active
                </button>
            </form>
        }
        <a href="/FormerPrisoners" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>Back</a>
    </div>
</div>

<!-- Archive status banner -->
<div class="alert d-flex align-items-center gap-3 mb-4" style="background:@reasonBg;border:1px solid @reasonColor;border-left:5px solid @reasonColor;border-radius:12px;">
    <i class="fas @(reason=="Released"?"fa-door-open":reason=="Transferred"?"fa-exchange-alt":reason=="Deceased"?"fa-cross":"fa-archive") fa-lg" style="color:@reasonColor;flex-shrink:0;"></i>
    <div>
        <strong style="color:@reasonColor;">Status: @reason</strong>
        <span class="text-muted ms-2" style="font-size:0.82rem;">
            Archived on @(Model.ArchivedAt?.ToString("MMMM dd, yyyy 'at' HH:mm") ?? "—")
            by <strong>@(Model.ArchivedBy ?? "System")</strong>
        </span>
        @if (!string.IsNullOrEmpty(Model.ArchiveNotes))
        {
            <div style="font-size:0.83rem;margin-top:3px;color:#374151;">Notes: @Model.ArchiveNotes</div>
        }
    </div>
</div>

<div class="row g-4">
    <!-- Left: Photo + core info -->
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header"><i class="fas fa-id-card me-2"></i>Identification</div>
            <div class="card-body text-center">
                @if (!string.IsNullOrEmpty(Model.PhotoPath))
                {
                    <img src="@Model.PhotoPath" style="width:130px;height:130px;border-radius:50%;object-fit:cover;border:4px solid #e2e8f0;margin-bottom:14px;" />
                }
                else
                {
                    <div style="width:130px;height:130px;border-radius:50%;background:linear-gradient(135deg,#94a3b8,#64748b);display:flex;align-items:center;justify-content:center;color:#fff;font-size:3rem;font-weight:700;margin:0 auto 14px;">
                        @(Model.FullName.Length > 0 ? Model.FullName[0].ToString().ToUpper() : "?")
                    </div>
                }
                <h5 class="fw-bold mb-1">@Model.FullName</h5>
                <div class="text-muted" style="font-size:0.82rem;">@Model.Gender</div>
                <div class="mt-3 d-flex flex-column gap-2" style="font-size:0.84rem;text-align:left;">
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Prisoner ID</span>
                        <code>@Model.PrisonerId</code>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">National ID</span>
                        <strong>@Model.NationalId</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Date of Birth</span>
                        <strong>@Model.DateOfBirth.ToString("MMM dd, yyyy")</strong>
                    </div>
                    <hr class="my-1" />
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Prison</span>
                        <strong>@(string.IsNullOrEmpty(Model.PrisonName) ? "—" : Model.PrisonName)</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">City</span>
                        <span>@(Model.PrisonCity ?? "—")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right: Record details -->
    <div class="col-lg-8">
        <div class="row g-4">
            <!-- Criminal record -->
            <div class="col-12">
                <div class="card">
                    <div class="card-header"><i class="fas fa-gavel me-2"></i>Criminal Record</div>
                    <div class="card-body">
                        <div class="row g-3" style="font-size:0.87rem;">
                            <div class="col-md-6">
                                <div class="text-muted mb-1">Crime Type</div>
                                <span class="badge bg-danger" style="font-size:0.8rem;">@Model.CrimeType</span>
                            </div>
                            <div class="col-md-6">
                                <div class="text-muted mb-1">Sentence Duration</div>
                                <strong>@Model.SentenceDurationMonths months (@(Model.SentenceDurationMonths / 12) yrs @(Model.SentenceDurationMonths % 12) mos)</strong>
                            </div>
                            <div class="col-md-4">
                                <div class="text-muted mb-1">Entry Date</div>
                                <strong>@Model.EntryDate.ToString("MMM dd, yyyy")</strong>
                            </div>
                            <div class="col-md-4">
                                <div class="text-muted mb-1">Release Date</div>
                                <strong>@Model.ReleaseDate.ToString("MMM dd, yyyy")</strong>
                            </div>
                            <div class="col-md-4">
                                <div class="text-muted mb-1">Final Status</div>
                                @{
                                    var statusBadge = Model.CriminalStatus switch {
                                        "Released"    => "bg-success",
                                        "Transferred" => "bg-primary",
                                        "Deceased"    => "bg-secondary",
                                        _             => "bg-warning text-dark"
                                    };
                                }
                                <span class="badge @statusBadge">@Model.CriminalStatus</span>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.FingerprintData))
                            {
                                <div class="col-12">
                                    <div class="text-muted mb-1">Fingerprint Data</div>
                                    <code style="font-size:0.78rem;">@Model.FingerprintData</code>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Personal details -->
            <div class="col-12">
                <div class="card">
                    <div class="card-header"><i class="fas fa-user me-2"></i>Personal Details</div>
                    <div class="card-body">
                        <div class="row g-3" style="font-size:0.87rem;">
                            @if (!string.IsNullOrEmpty(Model.Address))
                            {
                                <div class="col-md-6">
                                    <div class="text-muted mb-1">Address</div>
                                    <span>@Model.Address</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(Model.EmergencyContact))
                            {
                                <div class="col-md-6">
                                    <div class="text-muted mb-1">Emergency Contact</div>
                                    <span>@Model.EmergencyContact</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Archive metadata -->
            <div class="col-12">
                <div class="card" style="border-color:#d97706;">
                    <div class="card-header" style="background:linear-gradient(135deg,#78350f,#d97706);">
                        <i class="fas fa-shield-alt me-2"></i>Archive Audit Trail
                    </div>
                    <div class="card-body">
                        <div class="row g-3" style="font-size:0.87rem;">
                            <div class="col-md-4">
                                <div class="text-muted mb-1">Archive Reason</div>
                                <span class="badge" style="background:@reasonBg;color:@reasonColor;font-size:0.8rem;padding:5px 12px;">@reason</span>
                            </div>
                            <div class="col-md-4">
                                <div class="text-muted mb-1">Archived On</div>
                                <strong>@(Model.ArchivedAt?.ToString("MMM dd, yyyy HH:mm") ?? "—")</strong>
                            </div>
                            <div class="col-md-4">
                                <div class="text-muted mb-1">Archived By</div>
                                <strong>@(Model.ArchivedBy ?? "System")</strong>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.ArchiveNotes))
                            {
                                <div class="col-12">
                                    <div class="text-muted mb-1">Archive Notes</div>
                                    <p class="mb-0" style="background:var(--bs-secondary-bg);padding:10px;border-radius:8px;">@Model.ArchiveNotes</p>
                                </div>
                            }
                            <div class="col-md-4">
                                <div class="text-muted mb-1">Record Created</div>
                                <span>@Model.OriginalCreatedAt.ToString("MMM dd, yyyy")</span>
                            </div>
                            <div class="col-md-4">
                                <div class="text-muted mb-1">Last Updated</div>
                                <span>@Model.OriginalUpdatedAt.ToString("MMM dd, yyyy")</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
