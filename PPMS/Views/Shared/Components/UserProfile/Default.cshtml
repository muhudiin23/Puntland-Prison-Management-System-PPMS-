@model PPMS.Models.ApplicationUser
@{
    var initial = Model.FullName?.Length > 0 ? Model.FullName.Substring(0, 1).ToUpper() : "U";
    var roleLabel = Model.Role switch
    {
        "SuperAdmin" => "Super Administrator",
        "PrisonAdministrator" => "Prison Administrator",
        _ => "Staff User"
    };
    var roleBadgeColor = Model.Role switch
    {
        "SuperAdmin" => "#dc2626",
        "PrisonAdministrator" => "#d97706",
        _ => "#0891b2"
    };
    var prisonName = Model.AssignedPrison?.PrisonName;
}

<div class="dropdown">
    <button class="btn d-flex align-items-center gap-2 px-2 py-1 border-0" type="button"
            data-bs-toggle="dropdown" aria-expanded="false"
            style="background:transparent;border-radius:10px;transition:background 0.2s;"
            onmouseover="this.style.background='rgba(0,0,0,0.05)'" onmouseout="this.style.background='transparent'">
        @if (!string.IsNullOrEmpty(Model.ProfilePhotoPath))
        {
            <img src="@Model.ProfilePhotoPath" alt="Profile"
                 style="width:38px;height:38px;border-radius:50%;object-fit:cover;border:2px solid #e2e8f0;" />
        }
        else
        {
            <div style="width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,#1565c0,#1976d2);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:0.95rem;flex-shrink:0;">
                @initial
            </div>
        }
        <div class="text-start d-none d-lg-block">
            <div style="font-size:0.82rem;font-weight:700;color:#1e293b;line-height:1.1;">@Model.FullName</div>
            <div style="font-size:0.68rem;color:#64748b;font-weight:500;">@roleLabel</div>
            @if (!string.IsNullOrEmpty(prisonName))
            {
                <div style="font-size:0.63rem;color:#1565c0;font-weight:600;"><i class="fas fa-building me-1"></i>@prisonName</div>
            }
        </div>
        <i class="fas fa-chevron-down d-none d-lg-block" style="font-size:0.65rem;color:#94a3b8;"></i>
    </button>
    <ul class="dropdown-menu dropdown-menu-end shadow-lg" style="min-width:260px;border:none;border-radius:14px;padding:8px;">
        <li>
            <div class="px-3 py-3 border-bottom mb-1">
                <div class="d-flex align-items-center gap-3">
                    @if (!string.IsNullOrEmpty(Model.ProfilePhotoPath))
                    {
                        <img src="@Model.ProfilePhotoPath" style="width:50px;height:50px;border-radius:50%;object-fit:cover;border:3px solid #e2e8f0;" />
                    }
                    else
                    {
                        <div style="width:50px;height:50px;border-radius:50%;background:linear-gradient(135deg,#1565c0,#1976d2);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800;font-size:1.2rem;">@initial</div>
                    }
                    <div>
                        <div style="font-weight:700;color:#0f172a;font-size:0.9rem;">@Model.FullName</div>
                        <div style="font-size:0.72rem;color:#64748b;">@Model.Email</div>
                        <span class="badge mt-1" style="background:@roleBadgeColor;font-size:0.65rem;padding:2px 8px;">@roleLabel</span>
                    </div>
                </div>
            </div>
        </li>
        <li>
            <a class="dropdown-item d-flex align-items-center gap-2 py-2 rounded" href="/Settings"
               style="font-size:0.875rem;color:#374151;">
                <div style="width:30px;height:30px;background:#f0f9ff;border-radius:8px;display:flex;align-items:center;justify-content:center;">
                    <i class="fas fa-user" style="color:#0891b2;font-size:0.8rem;"></i>
                </div>
                My Profile & Settings
            </a>
        </li>
        <li>
            <a class="dropdown-item d-flex align-items-center gap-2 py-2 rounded" href="/Settings#security"
               style="font-size:0.875rem;color:#374151;">
                <div style="width:30px;height:30px;background:#fef9f0;border-radius:8px;display:flex;align-items:center;justify-content:center;">
                    <i class="fas fa-shield-alt" style="color:#d97706;font-size:0.8rem;"></i>
                </div>
                Change Password
            </a>
        </li>
        <li>
            <a class="dropdown-item d-flex align-items-center gap-2 py-2 rounded" href="/Settings#appearance"
               style="font-size:0.875rem;color:#374151;">
                <div style="width:30px;height:30px;background:#f5f3ff;border-radius:8px;display:flex;align-items:center;justify-content:center;">
                    <i class="fas fa-palette" style="color:#7c3aed;font-size:0.8rem;"></i>
                </div>
                Appearance
            </a>
        </li>
        <li><hr class="dropdown-divider my-1"></li>
        @if (!string.IsNullOrEmpty(Model.LastLoginAt?.ToString()))
        {
            <li>
                <div class="px-3 py-1 mb-1">
                    <small class="text-muted" style="font-size:0.7rem;">
                        <i class="fas fa-clock me-1"></i>Last login: @Model.LastLoginAt?.ToString("MMM dd, yyyy HH:mm")
                    </small>
                </div>
            </li>
        }
        <li>
            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                @Html.AntiForgeryToken()
                <button type="submit" class="dropdown-item d-flex align-items-center gap-2 py-2 rounded text-danger"
                        style="font-size:0.875rem;">
                    <div style="width:30px;height:30px;background:#fef2f2;border-radius:8px;display:flex;align-items:center;justify-content:center;">
                        <i class="fas fa-sign-out-alt" style="color:#dc2626;font-size:0.8rem;"></i>
                    </div>
                    Sign Out
                </button>
            </form>
        </li>
    </ul>
</div>
