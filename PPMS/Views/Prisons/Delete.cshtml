@model PPMS.Models.Prison
@{ ViewData["Title"] = "Delete Prison"; }
<div class="page-header"><h2><i class="fas fa-trash me-2 text-danger"></i>Delete Prison</h2></div>
<div class="card" style="max-width:500px;margin:0 auto;">
    <div class="card-body text-center py-5">
        <i class="fas fa-exclamation-triangle fa-3x text-danger mb-3"></i>
        <h5>Delete "@Model.PrisonName"?</h5>
        <p class="text-muted">This cannot be undone. All associated records must be removed first.</p>
        <form asp-action="Delete" method="post" class="d-inline me-2">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-danger">Yes, Delete</button>
        </form>
        <a href="/Prisons" class="btn btn-outline-secondary">Cancel</a>
    </div>
</div>
